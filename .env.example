# ─────────────────────────────────────────────────────
# Stellar Portal — Environment Variables
#
# FOR LOCAL DEV:
#   cp .env.example .env  →  fill in values  →  npm run dev
#   .env is gitignored, never committed
#
# FOR CLOUDFLARE PAGES (PRODUCTION):
#   Set these in CF Pages → Settings → Environment Variables
#   All VITE_ vars are public (bundled into JS) — no secrets here
# ─────────────────────────────────────────────────────

# ── Casdoor SSO ──
# Your Casdoor instance URL (no trailing slash)
VITE_CASDOOR_URL=https://sso.stellarglobalsupplies.com

# From Casdoor dashboard → Applications → your app → Client ID
VITE_CASDOOR_CLIENT_ID=your-client-id-here

# The app name you created in Casdoor
VITE_CASDOOR_APP_NAME=stellar-portal

# Your organization name in Casdoor
VITE_CASDOOR_ORG=stellar-global

# ── App URLs ──
# Add one per app. These show up as the launch URL on each card.
VITE_APP_SCANNER_URL=https://scan.stellarglobalsupplies.com
VITE_APP_PROWLER_URL=https://security.stellarglobalsupplies.com
# VITE_APP_YOUR_APP_URL=https://your-app.stellarglobalsupplies.com
